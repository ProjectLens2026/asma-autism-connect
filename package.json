{
  "name": "asma",
  "version": "0.1.10",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/server.mjs",
    "build": "node scripts/validate.mjs && node scripts/build.mjs",
    "start": "node scripts/server.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/drink-browser.mjs",
    "validate": "node scripts/validate.mjs",
    "release:check": "node scripts/validate.mjs --release",
    "pretest": "node scripts/validate.mjs && node scripts/build.mjs && node scripts/build-preview.mjs",
    "preview:build": "node scripts/build-preview.mjs",
    "test:touch-browser": "node tests/touch-browser.mjs"
  }
}
